    selectedPlayers = {}
    renderPlayerList()
    updateCount()
end)

-- Fling Engine
StartBtn.MouseButton1Click:Connect(function()
    if isFlinging then return end
    isFlinging = true
    
    task.spawn(function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then isFlinging = false return end
        local hrp = char.HumanoidRootPart
        
        -- สร้างแรงหมุนความเร็วสูง
        local bav = Instance.new("BodyAngularVelocity")
        bav.Name = "FlingForce"
        bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bav.AngularVelocity = Vector3.new(0, 999999, 0)
        bav.Parent = hrp

        while isFlinging and char and hrp do
            RunService.Heartbeat:Wait()
            local targetFound = false
            for targetName, isSelected in pairs(selectedPlayers) do
                if isSelected then
                    local targetPlayer = Players:FindFirstChild(targetName)
                    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        targetFound = true
                        local targetHrp = targetPlayer.Character.HumanoidRootPart
                        -- วาร์ปไปติดกับเป้าหมายเพื่อดีด
                        hrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 0)
                        hrp.Velocity = Vector3.new(99999, 99999, 99999)
                    end
                end
            end
            if not targetFound then task.wait(0.1) end
        end
        
        if bav then bav:Destroy() end
    end)
end)

StopBtn.MouseButton1Click:Connect(function()
    isFlinging = false
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        if hrp:FindFirstChild("FlingForce") then hrp.FlingForce:Destroy() end
        hrp.Velocity = Vector3.new(0, 0, 0)
    end
end)
