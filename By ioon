-- Button Events
SelectAllBtn.MouseButton1Click:Connect(function()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then selectedPlayers[p.Name] = true end
    end
    renderPlayerList()
    updateCount()
end)

