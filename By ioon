-- Selection Logic
local selectedPlayers = {}
local isFlinging = false

local function updateCount()
    local count = 0
    for _, v in pairs(selectedPlayers) do
        if v then count = count + 1 end
    end
    CounterLabel.Text = count .. " target(s) selected"
end

local function renderPlayerList()
    for _, item in pairs(ScrollList:GetChildren()) do
        if item:IsA("Frame") then item:Destroy() end
    end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local ItemFrame = Instance.new("Frame")
            ItemFrame.Size = UDim2.new(1, -6, 0, 32)
            ItemFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
            ItemFrame.Parent = ScrollList

            local ItemCorner = Instance.new("UICorner")
            ItemCorner.CornerRadius = UDim.new(0, 4)
            ItemCorner.Parent = ItemFrame

            local ToggleBtn = Instance.new("TextButton")
            ToggleBtn.Size = UDim2.new(0, 20, 0, 20)
            ToggleBtn.Position = UDim2.new(0, 8, 0.5, -10)
            ToggleBtn.BackgroundColor3 = selectedPlayers[p.Name] and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(60, 60, 70)
            ToggleBtn.Text = selectedPlayers[p.Name] and "✓" or ""
            ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            ToggleBtn.Font = Enum.Font.GothamBold
            ToggleBtn.TextSize = 12
            ToggleBtn.Parent = ItemFrame

            local NameLabel = Instance.new("TextLabel")
            NameLabel.Size = UDim2.new(1, -40, 1, 0)
            NameLabel.Position = UDim2.new(0, 35, 0, 0)
            NameLabel.BackgroundTransparency = 1
            NameLabel.Text = p.Name
            NameLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
            NameLabel.Font = Enum.Font.GothamMedium
            NameLabel.TextSize = 12
            NameLabel.TextXAlignment = Enum.TextXAlignment.Left
            NameLabel.Parent = ItemFrame

            ToggleBtn.MouseButton1Click:Connect(function()
                selectedPlayers[p.Name] = not selectedPlayers[p.Name]
                ToggleBtn.BackgroundColor3 = selectedPlayers[p.Name] and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(60, 60, 70)
                ToggleBtn.Text = selectedPlayers[p.Name] and "✓" or ""
                updateCount()
            end)
        end
    end
    ScrollList.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 10)
end

Players.PlayerAdded:Connect(renderPlayerList)
Players.PlayerRemoving:Connect(function(p)
    selectedPlayers[p.Name] = nil
    renderPlayerList()
    updateCount()
end)
renderPlayerList()

